# Backend API as seen from the Next.js server (SSR fetches + /api proxy)
API_URL=http://localhost:4000/api
API_PROXY_URL=http://localhost:4000/api

# Canonical public origin — used for SEO (canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://aksharum.com

# Optional: Search Console / Bing Webmaster Tools "HTML tag" verification
# tokens (just the content="..." value). Leave unset if verified via DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
